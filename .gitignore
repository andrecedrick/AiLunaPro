# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Frontend production env (Firebase web config + Turnstile site key).
# Public-ish but kept out of VCS — injected at build time only.
.env.production

# Claude Code per-machine local settings
.claude/settings.local.json

# Claude Code local tooling artifact (per-session worktrees)
.claude/worktrees/

# Ruflo / claude-flow LOCAL tooling artifacts (not required for the app to
# build/run; generated per-machine by `ruflo init`). settings.json hooks
# reference .claude/helpers/* via `IF EXIST` and fall back to %USERPROFILE%,
# so a fresh checkout works without these committed.
.claude-flow/
.swarm/
.mcp.json
ruvector.db
.claude/agents/
.claude/commands/
.claude/helpers/
.claude/skills/
*.backup.md
*.backup.json

# Test coverage output
coverage

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Stripe catalog export — account-specific, regenerated by scripts/stripe-setup.mjs --export
scripts/stripe-catalog.json
