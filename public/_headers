# Cloudflare Pages headers — caching policy (perf hardening, Batch A).
#
# HTML entry point must ALWAYS revalidate so a returning browser never serves a
# stale index.html that references chunk hashes from a previous deploy (cause of
# "Couldn't load the page" chunk-load failures after frequent redeploys).
# Hashed /assets/* are content-addressed → safe to cache forever (immutable).

# ── Content-Security-Policy (REPORT-ONLY, measurement phase) ────────────────
# Report-Only does NOT block anything — it only logs would-be violations to the
# browser DevTools console as "[Report Only]" messages (we have no report
# collector endpoint yet, so no report-uri/report-to is set; check manually).
# This first pass keeps 'unsafe-inline' for script/style: index.html has inline
# <script>/<style> blocks and the boot watchdog injects an inline onclick, which
# cannot be nonced/hashed without refactoring — out of scope for measurement.
# The value of this pass is validating the EXTERNAL allowlist (connect/script/
# frame/img/font hosts), which is the real risk when we later switch to enforce.
# Allowlist rationale: api.ailunapro.com (our API) · *.googleapis.com (Firebase
# Auth/Firestore/installations) · *.i.posthog.com (analytics, post-consent) ·
# js.stripe.com + api.stripe.com (Stripe) · challenges.cloudflare.com (Turnstile)
# · www.google.com + www.gstatic.com (App Check reCAPTCHA) · fonts.googleapis.com
# + fonts.gstatic.com (Google Fonts) · res.cloudinary.com (logo/favicon).
# KEEP THIS POLICY IN SYNC across the three HTML blocks below.

# The app shell (served at / and /index.html) is private + hash-routed →
# keep it out of search indexes (defense-in-depth with the noindex meta tag).
# Public static surfaces under their own paths (e.g. /audit-express/*) are NOT
# matched here and stay indexable.
/
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.stripe.com; connect-src 'self' https://api.ailunapro.com https://*.googleapis.com https://*.i.posthog.com https://api.stripe.com https://challenges.cloudflare.com https://www.google.com; frame-src 'self' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com; worker-src 'self' blob:; form-action 'self'

/index.html
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.stripe.com; connect-src 'self' https://api.ailunapro.com https://*.googleapis.com https://*.i.posthog.com https://api.stripe.com https://challenges.cloudflare.com https://www.google.com; frame-src 'self' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com; worker-src 'self' blob:; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public Audit Express surface (Phase 2): HTML must always revalidate (same
# stale-prevention policy as the app shell). Indexable — no X-Robots-Tag here.
# Same report-only policy (union superset — Turnstile + fonts + our API are the
# only origins this static page uses; the unused directives simply never fire).
/audit-express/*
  Cache-Control: no-cache, must-revalidate
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.stripe.com; connect-src 'self' https://api.ailunapro.com https://*.googleapis.com https://*.i.posthog.com https://api.stripe.com https://challenges.cloudflare.com https://www.google.com; frame-src 'self' https://js.stripe.com https://challenges.cloudflare.com https://www.google.com; worker-src 'self' blob:; form-action 'self'

