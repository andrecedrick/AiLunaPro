# ==============================================================================
# AI Luna Pro — Environment Variables
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env.local
#   2. Fill in values from your Firebase Console
#   3. NEVER commit .env.local  (it is already excluded by .gitignore via *.local)
# ==============================================================================


# ------------------------------------------------------------------------------
# FIREBASE WEB APP — Required
# Find these at:
#   Firebase Console → Project Settings → Your apps → Web app → SDK setup
# ------------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id


# ------------------------------------------------------------------------------
# FIREBASE ANALYTICS — Optional
# Leave blank or remove if you are not using Firebase Analytics.
# ------------------------------------------------------------------------------

VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ------------------------------------------------------------------------------
# LOCAL FIREBASE EMULATORS — Optional, development only
# Uncomment and set these when running:  firebase emulators:start
# Leave commented out for staging / production.
# ------------------------------------------------------------------------------

# VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
# VITE_AUTH_EMULATOR_URL=http://localhost:9099


# ------------------------------------------------------------------------------
# FEATURE FLAGS — Data layer selection (Phase E+)
# Controls whether each domain reads/writes from localStorage (mock) or Firebase.
#
# Values:  mock (default — safe without Firebase) | firebase
#
# VITE_DATA_LAYER is the global override for all data domains.
# Domain-specific vars take precedence over VITE_DATA_LAYER.
# Absent = mock.
# ------------------------------------------------------------------------------

VITE_DATA_LAYER=mock
VITE_AUTH_LAYER=mock
# VITE_REGISTRY_LAYER=firebase   # Set to 'firebase' to enable Firestore registry (Phase F.1+)
# VITE_AUDIT_LAYER=firebase      # Set to 'firebase' to enable Firestore audits (Phase F.2+)
# VITE_REPORTS_LAYER=mock
