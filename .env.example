# ==============================================================================
# AI Luna Pro — Environment Variables
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env.local
#   2. Fill in values from your Firebase Console
#   3. NEVER commit .env.local  (it is already excluded by .gitignore via *.local)
# ==============================================================================


# ------------------------------------------------------------------------------
# FIREBASE WEB APP — Required
# Find these at:
#   Firebase Console → Project Settings → Your apps → Web app → SDK setup
# ------------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id


# ------------------------------------------------------------------------------
# FIREBASE ANALYTICS — Optional
# Leave blank or remove if you are not using Firebase Analytics.
# ------------------------------------------------------------------------------

VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ------------------------------------------------------------------------------
# LOCAL FIREBASE EMULATORS — Optional, development only
# Uncomment and set these when running:  firebase emulators:start
# Leave commented out for staging / production.
# ------------------------------------------------------------------------------

# VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
# VITE_AUTH_EMULATOR_URL=http://localhost:9099


# ------------------------------------------------------------------------------
# FEATURE FLAGS — Data layer selection (Phase E+)
# Controls whether each domain reads/writes from localStorage (mock) or Firebase.
#
# Values:  mock (default — safe without Firebase) | firebase
#
# VITE_DATA_LAYER is the global override for all data domains.
# Domain-specific vars take precedence over VITE_DATA_LAYER.
# Absent = mock.
# ------------------------------------------------------------------------------

VITE_DATA_LAYER=mock
VITE_AUTH_LAYER=mock
# VITE_REGISTRY_LAYER=firebase   # Set to 'firebase' to enable Firestore registry (Phase F.1+)
# VITE_AUDIT_LAYER=firebase      # Set to 'firebase' to enable Firestore audits (Phase F.2+)
# VITE_REPORTS_LAYER=firebase    # Set to 'firebase' to enable Firestore reports (Phase F.3+)


# ------------------------------------------------------------------------------
# CLOUDFLARE WORKER — Phase G+
# These are wrangler.toml [vars] overrides for local dev.
# worker/wrangler.toml already sets defaults — only set here to override.
# ------------------------------------------------------------------------------

# WORKER_FIREBASE_PROJECT_ID=audit-ai-cc9e2
# WORKER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174


# ------------------------------------------------------------------------------
# STRIPE — Phase I.5+ (server-side ONLY)
#
# CRITICAL: Stripe secrets must NEVER be added to .env.local for the frontend.
# They live exclusively in the Cloudflare Worker environment, set via:
#
#   cd worker
#   wrangler secret put STRIPE_SECRET_KEY
#   wrangler secret put STRIPE_WEBHOOK_SECRET
#   wrangler secret put STRIPE_PUBLISHABLE_KEY
#   wrangler secret put STRIPE_PRICE_STARTER
#   wrangler secret put STRIPE_PRICE_PROFESSIONAL
#   wrangler secret put STRIPE_PRICE_ENTERPRISE
#
# The frontend reads ONLY booleans + masked metadata via
# GET /api/billing/config-status (Phase I.5 diagnostic page).
#
# DO NOT uncomment or fill these here.
# ------------------------------------------------------------------------------

# STRIPE_SECRET_KEY=          # NEVER commit. Set via `wrangler secret put`
# STRIPE_WEBHOOK_SECRET=      # NEVER commit. Set via `wrangler secret put`
# STRIPE_PUBLISHABLE_KEY=     # NEVER commit. Set via `wrangler secret put`
# STRIPE_PRICE_STARTER=       # NEVER commit. Set via `wrangler secret put`
# STRIPE_PRICE_PROFESSIONAL=  # NEVER commit. Set via `wrangler secret put`
# STRIPE_PRICE_ENTERPRISE=    # NEVER commit. Set via `wrangler secret put`
