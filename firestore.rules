rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// AI Luna Pro — Firestore Security Rules
// Branch:  audit
// Phase:   1D — Security rules
//
// Security model: multi-tenant RBAC
//
//   Isolation layer
//     Every document carries organizationId.
//     Subcollection rules enforce org isolation via the {orgId} path segment.
//     Root collection rules (subscriptions, billing_events, email_logs) use
//     resource.data.organizationId to resolve the org, then check membership.
//
//   Role layer
//     Source of truth: /organizations/{orgId}/members/{uid}
//     Roles: 'owner' | 'admin' | 'member' | 'billing'
//
//     isOwnerOrAdmin    → write access to most content
//     isContentMember   → read access to audits / reports / registry
//                         (billing role intentionally excluded)
//     isAnyMember       → read access to org metadata and member list
//     canManageBilling  → read access to subscriptions and billing events
//
//   Backend-only collections (client writes always blocked)
//     /subscriptions          → Stripe Firebase Extension + Cloud Functions
//     /billing_events         → Stripe Firebase Extension
//     /email_logs             → Cloud Functions
//     /activity_logs          → Cloud Functions
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    /** True if the request is authenticated. */
    function isAuth() {
      return request.auth != null;
    }

    /** The current user's Firebase Auth UID. */
    function uid() {
      return request.auth.uid;
    }

    /**
     * Returns the role of the current user in the given organization.
     *
     * Reads from: /organizations/{orgId}/members/{uid}
     * If the document does not exist, .data.role evaluates to null,
     * which fails every role check safely (null is not in any role list).
     *
     * Costs: 1 Firestore read per rule evaluation.
     */
    function getMemberRole(orgId) {
      return get(
        /databases/$(database)/documents/organizations/$(orgId)/members/$(uid())
      ).data.role;
    }

    /**
     * True if the user is an owner or admin of the org.
     * Required for: all write operations on org content.
     */
    function isOwnerOrAdmin(orgId) {
      return isAuth() && getMemberRole(orgId) in ['owner', 'admin'];
    }

    /**
     * True if the user is a content-level member: owner, admin, or member.
     * The billing role is intentionally excluded — billing staff have no
     * business need to read audit results, reports, or the AI registry.
     */
    function isContentMember(orgId) {
      return isAuth() && getMemberRole(orgId) in ['owner', 'admin', 'member'];
    }

    /**
     * True if the user holds any role in the org (owner, admin, member, billing, client).
     * Used for org-level metadata and member list reads.
     */
    function isAnyMember(orgId) {
      return isAuth() && getMemberRole(orgId) in ['owner', 'admin', 'member', 'billing', 'client'];
    }

    /**
     * True if the user can access billing data (subscriptions, billing events,
     * top-up history).
     *
     * Locked rule: Owner ⊇ Billing. The dedicated 'billing' role is an optional
     * delegate. Admin / member / client have NO billing access. (Token BALANCE
     * visibility is separate and handled by its own role list — members can see
     * their balance without billing access.)
     */
    function canManageBilling(orgId) {
      return isAuth() && getMemberRole(orgId) in ['owner', 'billing'];
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /agents/{agentId}                     ← Phase K0 (Agent Catalog)
    //
    // Single global catalog of AI agents. Read access enforced ONLY at the
    // Worker layer (requireRole excludes 'client'). The collection is
    // top-level and orgless, so Firestore rules cannot scope read by
    // org-membership role. Closed entirely to client-side reads to keep
    // the Worker as the single source of truth.
    // ─────────────────────────────────────────────────────────────────────────

    match /agents/{agentId} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /public_diagnostics/{id}              ← Phase K1A (Diagnostic Express)
    //
    // Public lead-magnet submissions. Worker is the only writer (service
    // account bypasses rules) and the only reader (admin-only read routes
    // not yet exposed). Closed to all client-side access.
    // 90-day retention via doc.expiresAt; TTL deletion handled separately.
    // ─────────────────────────────────────────────────────────────────────────

    match /public_diagnostics/{id} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /public_roi_calculations/{id}        ← Phase K2A (ROI Calculator)
    //
    // Public lead-magnet ROI submissions. Worker is the only writer (service
    // account bypasses rules). Closed to all client-side access.
    // 90-day retention via doc.expiresAt; TTL deletion handled separately.
    // ─────────────────────────────────────────────────────────────────────────

    match /public_roi_calculations/{id} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /demo_requests/{id}                  ← B2.2 (dashboard demo-request CTA)
    //
    // Authed demo requests, written ONLY by the worker (POST /api/demo-request,
    // service account bypasses rules). Closed to all client-side access — same
    // discipline as the public lead collections above.
    // ─────────────────────────────────────────────────────────────────────────

    match /demo_requests/{id} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /public_feedback/{id}                ← S1 (User feedback)
    //
    // Anonymous, no-PII product feedback (satisfaction / difficulty / blocker /
    // suggestion) captured after a tool result. Worker is the only writer
    // (service account bypasses rules). Closed to all client-side access.
    // 90-day retention via doc.expiresAt; TTL deletion handled separately.
    // ─────────────────────────────────────────────────────────────────────────

    match /public_feedback/{id} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /support_tickets/{id}                ← S2 (Support tickets)
    //
    // Structured issue reports (bug / question / billing), hybrid auth. Worker
    // is the only writer (service account bypasses rules); client access is
    // closed. No PII beyond the submitter email. Admin triage is backend-only.
    // ─────────────────────────────────────────────────────────────────────────

    match /support_tickets/{id} {
      allow read:  if false;
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /users/{userId}
    //
    // User profiles, created on first sign-in.
    // Document ID = Firebase Auth UID.
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own profile.
      allow read: if isAuth() && uid() == userId;

      // Users initialize their own profile document on first sign-in.
      allow create: if isAuth() && uid() == userId;

      // Users can update their own profile.
      // Org membership is managed through the members subcollection.
      allow update: if isAuth() && uid() == userId;

      // Deletion is blocked for client — handled by admin SDK or Cloud Functions.
      allow delete: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /organizations/{orgId}
    //
    // Top-level org document (one per workspace).
    // ─────────────────────────────────────────────────────────────────────────

    match /organizations/{orgId} {
      // Any org member (all four roles) can read the org document.
      allow read: if isAnyMember(orgId);

      // Any authenticated user can create an org.
      // They must set themselves as ownerId.
      allow create: if isAuth()
        && request.resource.data.ownerId == uid();

      // Owners and admins can update the org.
      // ownerId cannot be transferred via a client write — preventing
      // admins from elevating themselves to owner.
      allow update: if isOwnerOrAdmin(orgId)
        && request.resource.data.ownerId == resource.data.ownerId;

      // Only the owner can delete the org document.
      // Prefer soft-delete (set deletedAt) over hard-delete.
      allow delete: if isAuth() && getMemberRole(orgId) == 'owner';

      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/auditExpress/{auditId}  (J15 P1.1)
      // Saved Audit Express snapshots + PDF metadata (no PII). Written ONLY by
      // the worker (service account bypasses rules). Clients may read their own
      // org's saved audits; direct client writes are denied (defense-in-depth).
      // ───────────────────────────────────────────────────────────────────
      match /auditExpress/{auditId} {
        allow read:  if isAnyMember(orgId);
        allow write: if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/members/{memberId}
      //
      // memberId = userId — source of truth for role within this org.
      // Read by Firestore security rules via getMemberRole().
      // ───────────────────────────────────────────────────────────────────

      match /members/{memberId} {
        // All org members can view the member list.
        allow read: if isAnyMember(orgId);

        // Bootstrap exception only: org owner self-creates member doc on org creation.
        // All other writes go through the worker (service account bypasses rules).
        allow create: if (
            isAuth()
            && uid() == memberId
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == uid()
          );

        // J1.3E: client writes blocked. Worker uses service account.
        allow update: if false;
        allow delete: if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/invites/{inviteId}
      //
      // Phase J1.3E: invites are managed by the worker via service account.
      // Client can only READ for display purposes; all writes blocked.
      // ───────────────────────────────────────────────────────────────────

      match /invites/{inviteId} {
        allow read:   if isOwnerOrAdmin(orgId);
        allow write:  if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/audits/{auditId}
      //
      // Audit session documents — drives the multi-step compliance flow.
      // ───────────────────────────────────────────────────────────────────

      match /audits/{auditId} {
        // Content members (owner, admin, member) can read audits.
        // Billing role has no access to audit content.
        allow read: if isContentMember(orgId);

        // Content members (owner, admin, member) can create audit sessions —
        // members run and submit audits per the Team & Roles model. Billing
        // and client roles are excluded (isContentMember).
        // organizationId must match the path; createdBy must be the requester.
        allow create: if isContentMember(orgId)
          && request.resource.data.organizationId == orgId
          && request.resource.data.createdBy == uid();

        // Content members can update audit metadata (status, score, submit),
        // but ownership/system fields are immutable: organizationId and
        // createdBy cannot be changed on update (prevents a member moving an
        // audit to another org or spoofing the author).
        allow update: if isContentMember(orgId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.createdBy == resource.data.createdBy;

        // Only owners/admins can delete or archive audit sessions.
        allow delete: if isOwnerOrAdmin(orgId);


        // ─────────────────────────────────────────────────────────────────
        // /organizations/{orgId}/audits/{auditId}/answers/{answerId}
        //
        // Individual question responses within an audit session.
        // ─────────────────────────────────────────────────────────────────

        match /answers/{answerId} {
          // Content members can read all answers in an audit.
          allow read: if isContentMember(orgId);

          // Any content member can submit an answer.
          // auditId on the document must match the path segment (no spoofing).
          // answeredBy must be the requesting user.
          allow create: if isContentMember(orgId)
            && request.resource.data.auditId == auditId
            && request.resource.data.answeredBy == uid();

          // Any content member can update an existing answer (collaborative mode).
          // The auditId field cannot be changed after creation.
          allow update: if isContentMember(orgId)
            && request.resource.data.auditId == resource.data.auditId;

          // Only owners/admins can delete answers.
          allow delete: if isOwnerOrAdmin(orgId);
        }
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/reports/{reportId}
      //
      // Compliance reports generated from completed audits.
      // Members see only published reports. Owners/admins see all statuses.
      // ───────────────────────────────────────────────────────────────────

      match /reports/{reportId} {
        // Owners/admins read reports in any status (draft, published, archived).
        // Regular members can only read published reports.
        allow read: if isOwnerOrAdmin(orgId)
          || (isContentMember(orgId) && resource.data.status == 'published');

        // Only owners/admins can create reports.
        // organizationId must match the path.
        allow create: if isOwnerOrAdmin(orgId)
          && request.resource.data.organizationId == orgId;

        // Only owners/admins can update reports (e.g. publish, archive, edit).
        allow update: if isOwnerOrAdmin(orgId);

        // Only owners/admins can delete reports.
        allow delete: if isOwnerOrAdmin(orgId);


        // ─────────────────────────────────────────────────────────────────
        // /organizations/{orgId}/reports/{reportId}/exports/{exportId}
        //
        // Export events for a specific report (PDF, email, print, share-link).
        // Stored as a subcollection so they stay separate from report content.
        // ─────────────────────────────────────────────────────────────────

        match /exports/{exportId} {
          // Content members can read export events for reports they can access.
          allow read: if isOwnerOrAdmin(orgId)
            || (isContentMember(orgId) && get(/databases/$(database)/documents/organizations/$(orgId)/reports/$(reportId)).data.status == 'published');

          // Only owners/admins can record export events.
          // reportId on the document must match the path segment.
          allow create: if isOwnerOrAdmin(orgId)
            && request.resource.data.reportId == reportId;

          // Export events are immutable after creation.
          allow update: if false;

          // Only owners/admins can delete export records.
          allow delete: if isOwnerOrAdmin(orgId);
        }
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/registry/{systemId}
      //
      // AI system registry — one entry per deployed AI tool or model.
      // ───────────────────────────────────────────────────────────────────

      match /registry/{systemId} {
        // Content members can read the registry.
        allow read: if isContentMember(orgId);

        // Only owners/admins can add or modify registry entries.
        // Org isolation is enforced by the {orgId} path segment.
        allow create, update: if isOwnerOrAdmin(orgId);

        // Only owners/admins can remove registry entries.
        allow delete: if isOwnerOrAdmin(orgId);
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/exports/{exportId}
      //
      // Records of generated report exports (PDF, CSV, JSON).
      // Points to Firebase Storage via storageURL.
      // ───────────────────────────────────────────────────────────────────

      match /exports/{exportId} {
        // Content members can read (download) exports.
        allow read: if isContentMember(orgId);

        // Only owners/admins can generate export records.
        // organizationId must match the path.
        allow create: if isOwnerOrAdmin(orgId)
          && request.resource.data.organizationId == orgId;

        // Exports are immutable after creation — no updates allowed.
        allow update: if false;

        // Only owners/admins can delete expired or revoked exports.
        allow delete: if isOwnerOrAdmin(orgId);
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/billing_config/{docId}
      //
      // Non-secret Stripe metadata (price IDs, return URLs, plan labels).
      // Owner-only read/write. Phase I.6.
      // Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PUBLISHABLE_KEY)
      // are NEVER stored here — they live in worker env via `wrangler secret put`.
      // ───────────────────────────────────────────────────────────────────

      match /billing_config/{docId} {
        allow read:  if isAuth() && getMemberRole(orgId) == 'owner';
        allow write: if isAuth() && getMemberRole(orgId) == 'owner';
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/subscriptions/{docId}
      //
      // Live subscription state synced from Stripe by Cloudflare Worker
      // via the /api/stripe/webhook + /api/billing/sync-session endpoints.
      // Phase J1.
      //
      // Client-side: READ-ONLY for owner, admin, billing roles.
      // Writes are server-side only (worker uses Firebase Admin REST with
      // a service account, which bypasses these rules).
      // ───────────────────────────────────────────────────────────────────

      match /subscriptions/{docId} {
        allow read:  if canManageBilling(orgId);
        allow write: if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/tokens/current  (+ subcollections)
      //
      // Phase J1.4A — token balance + usage + topups.
      // Worker writes via service account (bypasses rules).
      // Client role NEVER reads tokens.
      // ───────────────────────────────────────────────────────────────────

      // canViewTokens: owner, admin, billing, member (NOT client)
      // canManageBilling already covers owner/admin/billing for topups.

      match /tokens/current {
        allow read:  if isAuth() && getMemberRole(orgId) in ['owner', 'admin', 'billing', 'member'];
        allow write: if false;
      }

      match /tokens/current/usage/{eventId} {
        // Read for owner/admin/billing org-wide; member sees own (server filters).
        allow read:  if isAuth() && getMemberRole(orgId) in ['owner', 'admin', 'billing', 'member'];
        allow write: if false;
      }

      match /tokens/current/topups/{sessionId} {
        allow read:  if canManageBilling(orgId);
        allow write: if false;
      }


      // ───────────────────────────────────────────────────────────────────
      // /organizations/{orgId}/activity_logs/{logId}
      //
      // Immutable audit trail. Written by Cloud Functions only.
      // ───────────────────────────────────────────────────────────────────

      match /activity_logs/{logId} {
        // Only owners and admins can read the activity trail.
        allow read: if isOwnerOrAdmin(orgId);

        // All client writes are permanently blocked.
        // Activity logs are appended exclusively by Cloud Functions
        // using the Firebase Admin SDK (which bypasses these rules).
        allow write: if false;
      }
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /subscriptions/{subscriptionId}
    //
    // Managed by the Stripe Firebase Extension and Cloud Functions.
    // Document ID = Stripe subscription ID.
    // organizationId is enriched by onStripeSubscriptionCreated Cloud Function.
    // ─────────────────────────────────────────────────────────────────────────

    match /subscriptions/{subscriptionId} {
      // Owners, admins, and the billing role can read subscription data.
      // Uses resource.data.organizationId to resolve the org.
      allow read: if canManageBilling(resource.data.organizationId);

      // All client writes are blocked.
      // Subscriptions are written by the Stripe extension and Cloud Functions.
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /billing_events/{eventId}
    //
    // Written exclusively by the Stripe Firebase Extension.
    // Stores the complete webhook payload for every Stripe event.
    // ─────────────────────────────────────────────────────────────────────────

    match /billing_events/{eventId} {
      // Owners, admins, and the billing role can read the billing event history.
      allow read: if canManageBilling(resource.data.organizationId);

      // All client writes are blocked.
      // Billing events are written exclusively by the Stripe extension.
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // /email_logs/{emailId}
    //
    // Written exclusively by Cloud Functions.
    // Provides a complete audit trail of every outbound email.
    // ─────────────────────────────────────────────────────────────────────────

    match /email_logs/{emailId} {
      // Only owners and admins can read the email log.
      allow read: if isOwnerOrAdmin(resource.data.organizationId);

      // All client writes are blocked.
      // Email logs are written exclusively by Cloud Functions.
      allow write: if false;
    }


    // ─────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    //
    // Any path not explicitly matched above is denied for both read and write.
    // This is the safe-by-default baseline for Firestore security.
    // ─────────────────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
